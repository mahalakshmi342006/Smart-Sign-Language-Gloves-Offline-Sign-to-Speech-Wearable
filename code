// =====================================================
// SETUP
// =====================================================
void setup() {

  Serial.begin(115200);

  // ---------------- Touch Sensors ----------------

  pinMode(TOUCH1, INPUT);
  pinMode(TOUCH2, INPUT);
  pinMode(TOUCH3, INPUT);
  pinMode(TOUCH4, INPUT);
  pinMode(TOUCH5, INPUT);


  // ---------------- MPU6050 ----------------

  Wire.begin(SDA_PIN, SCL_PIN);

  mpu.initialize();

  if (mpu.testConnection()) {

    Serial.println("MPU6050 Connected");

  } else {

    Serial.println("MPU6050 Connection Failed");
  }


  // =================================================
  // CREATE OFFLINE WI-FI NETWORK
  // =================================================

  WiFi.mode(WIFI_AP);

  WiFi.softAP(AP_SSID, AP_PASSWORD);

  Serial.println();
  Serial.println("==============================");
  Serial.println("SMART SIGN LANGUAGE GLOVE");
  Serial.println("==============================");

  Serial.print("Wi-Fi Name: ");
  Serial.println(AP_SSID);

  Serial.print("IP Address: ");
  Serial.println(WiFi.softAPIP());


  // ---------------- Web Server ----------------

  server.on("/", handleRoot);

  server.begin();

  Serial.println("Local Web Server Started");
}


// =====================================================
// LOOP
// =====================================================
void loop() {

  server.handleClient();

  readTouchSensors();

  int binaryValue = getBinaryValue();

  currentSign = recognizeSign(binaryValue);

  Serial.print("Touch Pattern: ");

  Serial.print(touch1);
  Serial.print(" ");
  Serial.print(touch2);
  Serial.print(" ");
  Serial.print(touch3);
  Serial.print(" ");
  Serial.print(touch4);
  Serial.print(" ");
  Serial.println(touch5);

  Serial.print("Binary Value: ");
  Serial.println(binaryValue);

  Serial.print("Detected Sign: ");
  Serial.println(currentSign);

  Serial.println("--------------------------");

  delay(300);
}
