#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <MPU6050.h>

// =====================================================
// SMART SIGN LANGUAGE GLOVE
// ESP32-C3 - OFFLINE VERSION
// =====================================================

// ---------------- Wi-Fi Access Point ----------------
const char* AP_SSID = "Smart_Glove";
const char* AP_PASSWORD = "12345678";

WebServer server(80);
MPU6050 mpu;

// ---------------- TTP223 TOUCH PINS ----------------
// Change these pins according to your ESP32-C3 board.
#define TOUCH1 2
#define TOUCH2 3
#define TOUCH3 4
#define TOUCH4 5
#define TOUCH5 6

// ---------------- MPU6050 I2C ----------------
// Change these if your board uses different I2C pins.
#define SDA_PIN 8
#define SCL_PIN 9

// ---------------- Variables ----------------
int touch1;
int touch2;
int touch3;
int touch4;
int touch5;

String currentSign = "No Sign";


// =====================================================
// READ TOUCH SENSORS
// =====================================================
void readTouchSensors() {

  touch1 = digitalRead(TOUCH1);
  touch2 = digitalRead(TOUCH2);
  touch3 = digitalRead(TOUCH3);
  touch4 = digitalRead(TOUCH4);
  touch5 = digitalRead(TOUCH5);
}


// =====================================================
// CONVERT TOUCH INPUT TO 5-BIT VALUE
// =====================================================
int getBinaryValue() {

  return (touch1 << 4) |
         (touch2 << 3) |
         (touch3 << 2) |
         (touch4 << 1) |
         touch5;
}


// =====================================================
// SIGN RECOGNITION
// =====================================================
String recognizeSign(int value) {

  switch (value) {

    case 0:
      return "No Sign";

    case 1:
      return "Hello";

    case 2:
      return "Yes";

    case 3:
      return "No";

    case 4:
      return "Thank You";

    case 5:
      return "Help";

    case 6:
      return "Good Morning";

    case 7:
      return "Good";

    case 8:
      return "Bad";

    case 9:
      return "Please";

    case 10:
      return "Sorry";

    case 11:
      return "Welcome";

    case 12:
      return "I Love You";

    case 13:
      return "Water";

    case 14:
      return "Food";

    case 15:
      return "Emergency";

    default:
      return "Unknown Sign";
  }
}


